# Database Configuration
DB_USER=jobportal
DB_PASSWORD=password
DB_NAME=job_portal
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://jobportal:password@postgres:5432/job_portal

# Redis Configuration
REDIS_URL=redis://redis:6379

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8000
EMPLOYER_SERVICE_URL=http://employer-service:8000
JOB_SERVICE_URL=http://job-service:8000
APPLICATION_SERVICE_URL=http://application-service:8000
RESUME_SERVICE_URL=http://resume-service:8000
SEARCH_SERVICE_URL=http://search-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# Email Configuration (optional for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Storage
STORAGE_PATH=/app/uploads
